# Talosmine — mẫu biến môi trường.
#
# File này ĐƯỢC commit và KHÔNG chứa secret thật. Mọi giá trị dưới đây là placeholder
# rõ ràng là giả (`CHANGE_ME_*`). Copy sang `.env` rồi điền giá trị thật:
#     cp .env.example .env
# `.env` đã nằm trong .gitignore — không bao giờ commit nó.
#
# Sinh secret ngẫu nhiên:
#     openssl rand -base64 32
#
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (container `db`)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser_password
POSTGRES_DB=postgres

# Password cho hai role riêng của Talosmine. Container `db` tạo chúng lúc init.
# Hai role KHÁC NHAU và không dùng chung password — đó là điểm chính của việc tách role.
TALOSMINE_MIGRATION_PASSWORD=CHANGE_ME_migration_role_password
TALOSMINE_RUNTIME_PASSWORD=CHANGE_ME_runtime_role_password

# ─────────────────────────────────────────────────────────────────────────────
# Supavisor (container `supavisor`) — transaction pooler
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY_BASE=CHANGE_ME_at_least_64_chars_openssl_rand_base64_48
VAULT_ENC_KEY=CHANGE_ME_exactly_32_chars_long_key
JWT_SECRET=CHANGE_ME_at_least_32_chars_jwt_secret
POOLER_TENANT_ID=talosmine
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# ─────────────────────────────────────────────────────────────────────────────
# Control Plane
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info

# RUNTIME: đi QUA Supavisor (cổng 6543 = transaction mode), dùng role runtime.
# Driver bắt buộc đặt `prepare: false` — xem apps/control-plane/src/shared/database.ts.
# Hostname `supavisor` chỉ resolve được TRONG network của compose; không có port nào
# bind ra host (DEC-T10).
DATABASE_URL=postgresql://talosmine_runtime.talosmine:CHANGE_ME_runtime_role_password@supavisor:6543/postgres

# MIGRATION: nối TRỰC TIẾP `db`, KHÔNG qua Supavisor, dùng role migration có quyền DDL.
# Chỉ drizzle-kit đọc biến này; API/worker không dùng.
MIGRATION_DATABASE_URL=postgresql://talosmine_migration:CHANGE_ME_migration_role_password@db:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Logto — identity provider self-host (DEC-T22, thay cho Auth0)
# ─────────────────────────────────────────────────────────────────────────────
# Mật khẩu role `logto` trong PostgreSQL. Logto sở hữu database riêng tên `logto`.
LOGTO_DB_PASSWORD=CHANGE_ME_logto_db_password

# URL mà BROWSER dùng để tới Logto. Dev: localhost qua dev overlay.
# Production: đổi sang domain thật đứng sau Caddy.
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# Cấu hình OIDC cho Control Plane verify token và cho BFF chạy luồng login.
# Điền SAU khi tạo application trong Logto Admin Console (http://localhost:3002).
# OIDC_ISSUER_URL thường là <LOGTO_ENDPOINT>/oidc
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=CHANGE_ME_sau_khi_tao_app_trong_logto
