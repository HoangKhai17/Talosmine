# Talosmine — mẫu biến môi trường.
#
# File này ĐƯỢC commit và KHÔNG chứa secret thật. Mọi giá trị dưới đây là placeholder
# rõ ràng là giả (`CHANGE_ME_*`). Copy sang `.env` rồi điền giá trị thật:
#     cp .env.example .env
# `.env` đã nằm trong .gitignore — không bao giờ commit nó.
#
# Sinh secret ngẫu nhiên:
#     openssl rand -base64 32
#
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (container `db`)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser_password
POSTGRES_DB=postgres

# Password cho hai role riêng của Talosmine. Container `db` tạo chúng lúc init.
# Hai role KHÁC NHAU và không dùng chung password — đó là điểm chính của việc tách role.
TALOSMINE_MIGRATION_PASSWORD=CHANGE_ME_migration_role_password
TALOSMINE_RUNTIME_PASSWORD=CHANGE_ME_runtime_role_password

# ─────────────────────────────────────────────────────────────────────────────
# Supavisor (container `supavisor`) — transaction pooler
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY_BASE=CHANGE_ME_at_least_64_chars_openssl_rand_base64_48
VAULT_ENC_KEY=CHANGE_ME_exactly_32_chars_long_key
JWT_SECRET=CHANGE_ME_at_least_32_chars_jwt_secret
POOLER_TENANT_ID=talosmine
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# ─────────────────────────────────────────────────────────────────────────────
# Control Plane
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info

# RUNTIME: đi QUA Supavisor (cổng 6543 = transaction mode), dùng role runtime.
# Driver bắt buộc đặt `prepare: false` — xem apps/control-plane/src/shared/database.ts.
# Hostname `supavisor` chỉ resolve được TRONG network của compose; không có port nào
# bind ra host (DEC-T10).
DATABASE_URL=postgresql://talosmine_runtime.talosmine:CHANGE_ME_runtime_role_password@supavisor:6543/postgres

# MIGRATION: nối TRỰC TIẾP `db`, KHÔNG qua Supavisor, dùng role migration có quyền DDL.
# Chỉ drizzle-kit đọc biến này; API/worker không dùng.
MIGRATION_DATABASE_URL=postgresql://talosmine_migration:CHANGE_ME_migration_role_password@db:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Logto — identity provider self-host (DEC-T22, thay cho Auth0)
# ─────────────────────────────────────────────────────────────────────────────
# Mật khẩu role `logto` trong PostgreSQL. Logto sở hữu database riêng tên `logto`.
LOGTO_DB_PASSWORD=CHANGE_ME_logto_db_password

# URL mà BROWSER dùng để tới Logto. Dev: localhost qua dev overlay.
# Production: đổi sang domain thật đứng sau Caddy.
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# Cấu hình OIDC cho Control Plane verify token và cho BFF chạy luồng login.
# Điền SAU khi tạo application kiểu "Traditional Web" trong Logto Admin Console.
# OIDC_ISSUER_URL thường là <LOGTO_ENDPOINT>/oidc
#
# Trong Logto, Redirect URI của app phải đặt đúng bằng: <APP_BASE_URL>/auth/callback
# Sai một ký tự là Logto từ chối redirect — đây là lỗi cấu hình hay gặp nhất.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=CHANGE_ME_sau_khi_tao_app_trong_logto

# ─────────────────────────────────────────────────────────────────────────────
# BFF (apps/web) — chỉ đọc phía server
# ─────────────────────────────────────────────────────────────────────────────
# KHÔNG biến nào ở đây được mang tiền tố NEXT_PUBLIC_: đó là điều kiện để bundler của
# Next không inline giá trị vào client bundle, giữ OIDC_CLIENT_SECRET ở lại server.

# Base URL của chính app web. Dùng để dựng redirect_uri và các redirect nội bộ.
APP_BASE_URL=http://localhost:3000

# Base URL của Control Plane, nhìn từ process server của Next.
# Đây là chi tiết nội bộ — browser không bao giờ thấy giá trị này.
# Lưu ý cổng: Control Plane dùng API_PORT (mặc định dev là 3100) để KHÔNG đụng
# cổng 3001 của Logto.
CONTROL_PLANE_BASE_URL=http://localhost:3100

# ─────────────────────────────────────────────────────────────────────────────
# Catalog (P3) — allowlist host cho launch_url và image_url
# ─────────────────────────────────────────────────────────────────────────────
# Định dạng: host hoặc host!internal, phân cách bằng dấu phẩy.
# `!internal` = hạ tầng của chính dự án, được phép nằm trên địa chỉ nội bộ (DEC-T12).
#
# ĐỂ TRỐNG nghĩa là từ chối MỌI URL ngoài — mặc định nghiêng về an toàn.
# Nội dung cụ thể chờ DEC-B01 (danh sách ứng dụng của Hub).
CATALOG_ALLOWED_HOSTS=

# ─────────────────────────────────────────────────────────────────────────────
# Gửi thư (SMTP) — Logto dùng để gửi thư xác minh và đặt lại mật khẩu
# ─────────────────────────────────────────────────────────────────────────────
# Những biến này KHÔNG được ứng dụng đọc. Chúng chỉ là đầu vào của
# `infra/scripts/configure-logto-email.mjs`, script ghi cấu hình vào Logto.
#
# Đổi nhà cung cấp = đổi giá trị ở đây rồi chạy lại script. KHÔNG sửa mã nguồn.
#
# ── Dev: Mailpit (mặc định) ──────────────────────────────────────────────────
# Mailpit KHÔNG gửi thư đi đâu — nó bắt lại để bạn xem ở http://localhost:8025.
# `mailpit` là tên service trong mạng nội bộ của compose, không phải tên miền thật.
SMTP_HOST=mailpit
SMTP_PORT=1025
# `secure=false` + `requireTLS=false`: Mailpit chạy SMTP trần trong mạng nội bộ của
# Docker. Bật TLS ở đây sẽ fail bắt tay, không thêm được gì.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Talosmine <khong-tra-loi@talosmine.local>
#
# ── Kiểm chứng đường gửi thật: Gmail + App Password ──────────────────────────
# Cần bật 2FA trước thì https://myaccount.google.com/apppasswords mới hiện ra.
#
# ⚠ App Password là quyền GỬI THƯ DƯỚI DANH NGHĨA BẠN, không giới hạn người nhận.
#   Đặt vào `.env` (đã gitignore), KHÔNG dán vào chat hay commit. Thu hồi được bất cứ
#   lúc nào ở chính trang trên.
#
# ⚠ Gmail GHI ĐÈ `From` thành chính địa chỉ đã xác thực. Đặt SMTP_FROM_EMAIL là địa chỉ
#   khác thì thư vẫn tới nơi mang tên Gmail của bạn, trừ khi đã xác minh alias trong
#   Gmail → Settings → "Send mail as".
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false          # 587 dùng STARTTLS, không phải TLS ngay từ đầu
#   SMTP_REQUIRE_TLS=true
#   SMTP_USER=ban@gmail.com
#   SMTP_PASSWORD=<16 ky tu App Password, khong co dau cach>
#   SMTP_FROM_EMAIL=Talosmine <ban@gmail.com>
#
# ── Production ───────────────────────────────────────────────────────────────
# Máy chủ mail của chính bạn, hoặc dịch vụ gửi thư giao dịch (SES, Mailgun,
# Postmark…). Dạng biến giống hệt.
#
# ⚠ KHÔNG BAO GIỜ trỏ production vào Mailpit. Nó không gửi thư đi, và giao diện web của
#   nó chứa mọi link đặt lại mật khẩu còn hiệu lực.
#
# Dù chọn hướng nào cũng phải đặt SPF, DKIM, DMARC cho tên miền — thiếu thì thư vào spam.

# ─────────────────────────────────────────────────────────────────────────────
# Logto Management API — cho script cấu hình trong infra/
# ─────────────────────────────────────────────────────────────────────────────
# Tạo MỘT LẦN: Logto Admin Console (http://localhost:3002)
#   → Applications → Create → Machine-to-Machine
#   → Permissions → gán vai trò có quyền Management API
# Rồi chép App ID / App Secret vào đây.
#
# Vì sao cần: cấu hình Logto (connector thư, giao diện đăng nhập, ngôn ngữ) nằm trong
# DATABASE của Logto, không nằm trong git. Bấm tay trong Admin Console thì máy dev một
# kiểu, production một kiểu, và không ai review được. Script + biến môi trường giữ cấu
# hình đó ở dạng đọc và duyệt được — cùng lý do ta viết migration thay vì tạo bảng tay.
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=
