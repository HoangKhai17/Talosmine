{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next biên dịch bằng bundler riêng; tsc ở đây chỉ dùng để typecheck.
    // Vì vậy tắt emit/composite của base — composite yêu cầu emit nên không dùng chung được.
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,

    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
