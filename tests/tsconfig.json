{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Vitest biên dịch bằng Vite; tsc ở đây chỉ để typecheck.
    // composite yêu cầu emit nên không dùng chung được với noEmit (giống apps/web).
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,

    // Vitest resolve module qua Vite, không qua Node. `bundler` là mô hình khớp với
    // thứ thật sự chạy — dùng NodeNext ở đây sẽ bắt import phải có đuôi `.js` trong khi
    // Vite không yêu cầu, tức tsc sẽ kiểm một hợp đồng khác với runtime.
    "module": "ESNext",
    "moduleResolution": "bundler",

    // DOM lib có mặt vì Playwright đã được thêm vào workspace này: callback của
    // `page.evaluate()` chạy TRONG TRÌNH DUYỆT nên cần `document`/`getComputedStyle`.
    // Unit/integration/concurrency vẫn chạy ở Node (`environment: 'node'`) — DOM lib chỉ
    // ảnh hưởng typecheck, không đưa API browser nào vào runtime Node.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],

    // Test e2e import AppModule của Control Plane, kéo theo các controller/service dùng
    // decorator NestJS. tsc phải hiểu decorator để typecheck các file đó. Ba cờ này khớp
    // với apps/control-plane/tsconfig.json — verbatimModuleSyntax phải TẮT vì nó xung khắc
    // với emitDecoratorMetadata (metadata cần type import còn sống ở runtime).
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false
  },
  "include": ["**/*.ts", "../vitest.config.ts"],
  "exclude": ["node_modules"]
}
